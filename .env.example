# ============================================================
# ExamAgent configuration
# Copy to .env and fill in. Nothing here is required to RUN the
# app: without an API key ExamAgent runs in OFFLINE mode using the
# deterministic question/calculation engines and the seed bank.
# ============================================================

# anthropic | openai | none
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model used for tutoring / generation / evaluation
MODEL_NAME=claude-sonnet-4-5
MAX_TOKENS=2000
TEMPERATURE=0.3

# Language of LLM-generated lessons, chat explanations, generated questions and
# open-answer feedback: en | az (Azerbaijani). Deterministic offline content
# (calculation problems, the assertion-reason bank, the seed question bank) is
# fixed English text and is not translated - this only affects LLM output.
LANGUAGE=en

# Retrieval / embeddings
# local  -> TF-IDF + BM25 hybrid, no network, no API cost (default)
# openai -> text-embedding-3-small (requires OPENAI_API_KEY)
EMBEDDING_BACKEND=local
# local | chroma
VECTOR_BACKEND=local
CHUNK_SIZE=1100
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=6

# Exam schedule
EXAM_DATE=
STUDY_DAYS=7

# Exam readiness weights (must sum to 1.0)
READINESS_W_CRITICAL=0.30
READINESS_W_CALCULATION=0.20
READINESS_W_REASONING=0.20
READINESS_W_EXAM=0.15
READINESS_W_COVERAGE=0.10
READINESS_W_CONFIDENCE=0.05

# Storage
DATA_DIR=data
LOG_LEVEL=INFO
